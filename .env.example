# URL y clave anónima (pública) de tu proyecto Supabase.
# Las encuentras en: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-publica

# URL pública de producción (para generar el QR). En local puedes dejarlo
# vacío: se usará automáticamente la URL del navegador.
VITE_PUBLIC_SITE_URL=https://tu-app.vercel.app
